# 本機正式模式範例；正式託管時請在平台的 Secrets / Environment Variables 設定。
NODE_ENV=production
HOST=0.0.0.0
# PORT 由託管平台提供，不要在正式服務寫死。
# PORT=10000
STARSHIP_ADMIN_KEY=請替換成你自己的長密鑰
# 僅供本機／測試服暫時開啟隱藏星律測試補給；正式服請保持未設定或 false。
STARSHIP_TEST_REWARDS=false
# 設定 DATABASE_URL 後，伺服器會改用 Postgres；未設定時才使用本機 ./data/players.json。
# DATABASE_URL=postgresql://user:password@host:5432/database
# 本機 JSON 備援資料目錄。
STARSHIP_DATA_DIR=./data
